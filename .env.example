# Copy this file to .env and fill in the values.

# PostgreSQL connection string (required)
DATABASE_URL=postgres://user:password@localhost:5432/calories

# OpenAI API key for the AI features: meal analysis, restaurant search, Smart Organizer (required for AI)
OPENAI_API_KEY=

# Optional: OpenAI-compatible endpoint (leave empty for api.openai.com)
OPENAI_BASE_URL=

# Optional: protect the whole site with a password (recommended when hosted publicly)
APP_PASSWORD=

# Optional: the name shown in the app header
OWNER_NAME=

# Port to listen on (most hosts set this for you)
PORT=5000
